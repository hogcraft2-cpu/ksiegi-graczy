name = "ksiegi-graczy-api"
main = "worker.js"
compatibility_date = "2026-10-01"

[vars]
# Wymień na domenę, z której korzysta kreator.
# Kilka adresów rozdziel przecinkami.
ALLOWED_ORIGINS = "https://hogcraft2-cpu.github.io"

[[d1_databases]]
binding = "DB"
database_name = "ksiegi-graczy-db"
database_id = "WPISZ_ID_BAZY_D1"

# Nie jest potrzebne R2. Publiczne kroniki Worker zapisuje na GitHubie.
# Sekrety Workera (nigdy w tym pliku):
#   npx wrangler secret put GITHUB_TOKEN
#   npx wrangler secret put ADMIN_SECRET
#   npx wrangler secret put RATE_SALT

# Opcjonalnie: ilustracje historyczne z Workers AI.
[ai]
binding = "AI"
